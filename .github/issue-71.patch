+            ...(row.manufacture_year === null ? {} : { year: row.manufacture_year }),
+          },
+        }),
+      );
+      await client.query('COMMIT');
+      return {
+        requests,
+        nextCursor: result.rows.length > options.limit ? requests[requests.length - 1].id : null,
