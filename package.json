{
  "name": "autokosova",
  "version": "0.0.0",
  "engines": {
    "node": ">=24 <25",
    "npm": ">=11"
  },
  "scripts": {
    "ng": "ng",
    "start": "ng serve",
    "start:ssr": "node dist/autokosova/server/server.mjs",
    "build": "ng build",
    "watch": "ng build --watch --configuration development",
    "test": "ng test",
    "test:server": "tsx --test test/**/*.test.ts",
    "test:smoke": "node scripts/smoke.mjs",
    "lint": "eslint src --max-warnings=0",
    "typecheck": "tsc --noEmit -p tsconfig.app.json",
    "format:check": "prettier --check .github/workflows .github/PULL_REQUEST_TEMPLATE.md .postcssrc.json .prettierrc angular.json compose.yaml eslint.config.mjs package.json tsconfig*.json src scripts test db",
    "format:write": "prettier --write .github/workflows .github/PULL_REQUEST_TEMPLATE.md .postcssrc.json .prettierrc angular.json compose.yaml eslint.config.mjs package.json tsconfig*.json src scripts test db",
    "db:migrate": "node scripts/db/migrate.mjs",
    "db:seed": "node scripts/db/seed.mjs",
    "db:reset": "node scripts/db/reset.mjs",
    "verify": "npm run format:check && npm run lint && npm run typecheck && npm test && npm run test:server && npm run build && npm run test:smoke"
  },
  "private": true,
  "packageManager": "npm@11.12.1",
  "dependencies": {
    "@angular/common": "^22.1.0",
    "@angular/compiler": "^22.1.0",
    "@angular/core": "^22.1.0",
    "@angular/forms": "^22.1.0",
    "@angular/platform-browser": "^22.1.0",
    "@angular/platform-server": "^22.1.0",
    "@angular/router": "^22.1.0",
    "@angular/ssr": "^22.1.8",
    "@fastify/cookie": "11.1.2",
    "@fastify/static": "10.1.3",
    "fastify": "5.12.4",
    "jose": "6.2.12",
    "pg": "8.23.0",
    "rxjs": "~7.8.0",
    "tslib": "^2.3.0"
  },
  "devDependencies": {
    "@angular/build": "^22.1.8",
    "@angular/cli": "^22.1.8",
    "@angular/compiler-cli": "^22.1.0",
    "@eslint/js": "10.0.1",
    "@tailwindcss/postcss": "^4.1.12",
    "@types/node": "^20.17.19",
    "@types/pg": "8.23.1",
    "eslint": "10.10.0",
    "jsdom": "^28.0.0",
    "postcss": "^8.5.3",
    "prettier": "^3.8.1",
    "tailwindcss": "^4.1.12",
    "tsx": "4.23.13",
    "typescript": "~6.0.2",
    "typescript-eslint": "8.70.0",
    "vitest": "^4.0.8"
  }
}
