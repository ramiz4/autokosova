# dev:* derives the DB port and DATABASE_URL; Angular defaults to 4200.
# Optional overrides in .env.local. Blank ports use the worktree defaults.
AUTOKOSOVA_DB_PORT=
AUTOKOSOVA_APP_PORT=
# Manual db:* / npm start only: set the explicit local DB URL (see README).
DATABASE_URL=
PUBLIC_SITE_URL=
# Keep disabled until the operator has completed the legal/privacy review described in docs/MEASUREMENT.md.
AUTOKOSOVA_ANALYTICS_ENABLED=false
# Nur fuer den expliziten lokalen Demo-Seed setzen; nie in geteilten Umgebungen verwenden.
AUTOKOSOVA_DEMO_DATA=
# Nur zusammen mit AUTOKOSOVA_DEMO_DATA fuer fiktive lokale Workflowdaten setzen.
AUTOKOSOVA_DEMO_WORKFLOW_DATA=
PORT=4000
ZITADEL_AUDIENCE=
# Fiktive lokale Testkonten und ihre Passwörter liegen nur im freigegebenen 1Password-Store.
ZITADEL_AUTHORIZATION_ENDPOINT=
ZITADEL_CLIENT_ID=
ZITADEL_ISSUER=
ZITADEL_JWKS_URI=
# Only enable with complete OIDC config and the matching registered callback:
# ZITADEL_REDIRECT_URI=http://localhost:4200/auth/callback
ZITADEL_REDIRECT_URI=
ZITADEL_TOKEN_ENDPOINT=
# Optional same-issuer endpoint. When unset, read userinfo_endpoint from trusted OIDC discovery.
# No provider setting or management credential is needed for profile/email scopes.
ZITADEL_USERINFO_ENDPOINT=
# Optional provider-logout pair: use end_session_endpoint from trusted discovery of the configured issuer.
# Register the exact callback first, set both values together, then restart the dev starter.
ZITADEL_END_SESSION_ENDPOINT=
# ZITADEL_POST_LOGOUT_URI=http://localhost:4200/auth/logout/callback
ZITADEL_POST_LOGOUT_URI=

# Optional: assign two existing Test-OIDC accounts to local workflow fixtures.
# Read the actual subjects from the approved secret store, not from email addresses.
# Requires the complete ZITADEL configuration and npm run dev:demo-workflows.
# ak-test-garage-20260913@example.test -> actual OIDC sub:
AUTOKOSOVA_DEMO_GARAGE_SUBJECT=
# ak-test-customer-20260913@example.test -> actual OIDC sub:
AUTOKOSOVA_DEMO_CUSTOMER_SUBJECT=

# Optional, approved local staff demo binding (never derive from names/email or assign roles here):
# AUTOKOSOVA_DEMO_ADMIN_SUBJECT=
# AUTOKOSOVA_DEMO_MODERATOR_SUBJECT=
# The workflow starter enables local fixture files only for its demo process.
# AUTOKOSOVA_LOCAL_DEMO_FILES=1
